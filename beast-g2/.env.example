# Server only. Never put provider credentials in VITE_* or the .ehpk.
GATEWAY_TOKEN=replace-with-a-random-token-of-at-least-16-characters
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Full endpoint URLs: do not guess whether the provider appends /v1.
BEAST_CHAT_URL=https://beast.example.com/v1/chat/completions
BEAST_STT_URL=https://beast.example.com/v1/audio/transcriptions
BEAST_API_KEY=
BEAST_STT_API_KEY=
BEAST_CHAT_MODEL=beast/big
BEAST_STT_MODEL=whisper-live
UPSTREAM_TIMEOUT_MS=90000
# Fixed-window request limit for the single gateway token.
RATE_LIMIT=30
RATE_WINDOW_MS=60000

# Opt-in stored sessions. Use an absolute path; defaults to ~/.local/share/beast-g2.
# Audio is deleted after transcription or 24 hours.
SESSION_DATA_DIR=
# SESSION_DB_PATH defaults to SESSION_DATA_DIR/sessions.sqlite.
SESSION_RETENTION_DAYS=30
AUDIO_RETENTION_HOURS=24
AUDIO_QUOTA_BYTES=536870912
MAX_SESSION_MS=3600000
MAX_TRANSCRIPT_CHARS=100000
MAX_IMPORT_BYTES=134217728
SEGMENT_MS=30000
WORKER_POLL_MS=500
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_MS=1000
WORKER_TIMEOUT_MS=90000
WRITER_LEASE_MS=60000
DISK_RESERVE_BYTES=67108864
# Summary generation is opt-in through the same stored session API.
SUMMARY_MAX_CHARS=100000
SUMMARY_CHUNK_CHARS=12000
SUMMARY_MAX_CHUNKS=12
SUMMARY_MAX_ITEMS=100

# Optional, server-only. Enables explicit web commands through the custom gateway.
BRAVE_SEARCH_API_KEY=

# Opt-in read-only work context. Server only; never use VITE_* for these values.
WORK_CONTEXT_ENABLED=0
NOTION_WORKSPACE_ID=
NOTION_REDIRECT_URI=https://gateway.example.com/api/notion/callback
# Generate with: openssl rand -hex 32. Keep separate from the credential file/backups.
NOTION_TOKEN_ENCRYPTION_KEY=
