# Server only. Never put provider credentials in VITE_* or the .ehpk.
GATEWAY_TOKEN=replace-with-a-random-token-of-at-least-16-characters
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Full endpoint URLs: do not guess whether the provider appends /v1.
BEAST_CHAT_URL=https://beast.example.com/v1/chat/completions
BEAST_STT_URL=https://beast.example.com/v1/audio/transcriptions
BEAST_API_KEY=
BEAST_STT_API_KEY=
BEAST_CHAT_MODEL=beast/big
BEAST_STT_MODEL=whisper-live
UPSTREAM_TIMEOUT_MS=90000
# Fixed-window request limit for the single gateway token.
RATE_LIMIT=30
RATE_WINDOW_MS=60000

# Optional, server-only. Enables explicit web commands through the custom gateway.
BRAVE_SEARCH_API_KEY=
